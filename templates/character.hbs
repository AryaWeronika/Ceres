<form class="{{cssClass}} ceres-sheet" autocomplete="off">
    {{!-- dane podstawowe --}}
    <header class="ceres-header">
        <h1 class="ceres-logo">CERES</h1>
        <div class="row inline-fields">
            <label>IMIĘ:</label> <input type="text" name="name" value="{{actor.name}}" />
            <label>KSYWA:</label> <input type="text" name="system.dane.ksywa" value="{{system.dane.ksywa}}" />
            <label>NAZWISKO:</label> <input type="text" name="system.dane.nazwisko" value="{{system.dane.nazwisko}}" />
        </div>
        <div class="row inline-fields">
            <label>PRZESZŁOŚĆ:</label> <input type="text" name="system.dane.przeszlosc" value="{{system.dane.przeszlosc}}" />
            <label>SŁABOŚĆ:</label> <input type="text" name="system.dane.slabosc" value="{{system.dane.slabosc}}" />
        </div>
        <div class="row inline-fields">
            <div class="profile-img-container">
                <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
            </div>
            <label>WYGLĄD:</label> <input type="text" name="system.dane.wyglad" value="{{system.dane.wyglad}}" />
        </div>
    </header>

    <hr class="ceres-divider" />

    <div class="attribute-title-container">
        <div class="attribute-row header-row">
            <h2 class="attr-name">ATRYBUTY</h2>
            <span class="col-head short-input">
                MAKS.
                <a class="toggle-lock" title="Zablokuj/Odblokuj edycję MAKS." style="cursor: pointer; margin-left: 3px;">
                    <i class="fas {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
                </a>
            </span>
            <span class="col-head short-input">OBECNIE</span>
        </div>

        <button type="button" class="btn-rest" title="Przywraca wszystkie atrybuty do wartości MAKS.">
            ZŁAP ODDECH
        </button>
    </div>

    {{!-- krzepa --}}
    <div class="attribute-row">
        <label class="attr-name rollable" data-roll="{{system.atrybuty.krzepa.val}}" data-label="Krzepa">
            Krzepa:
        </label>

        <select name="system.atrybuty.krzepa.max" class="short-input" {{#if locked}} disabled{{/if}}>
            <option value="k4" {{#if (eq system.atrybuty.krzepa.max "k4")}} selected{{/if}}>k4</option>
            <option value="k6" {{#if (eq system.atrybuty.krzepa.max "k6")}} selected{{/if}}>k6</option>
            <option value="k8" {{#if (eq system.atrybuty.krzepa.max "k8")}} selected{{/if}}>k8</option>
            <option value="k10" {{#if (eq system.atrybuty.krzepa.max "k10")}} selected{{/if}}>k10</option>
            <option value="k12" {{#if (eq system.atrybuty.krzepa.max "k12")}} selected{{/if}}>k12</option>
        </select>

        <select name="system.atrybuty.krzepa.val" class="short-input">
            <option value="k4" {{#if (eq system.atrybuty.krzepa.val "k4")}} selected{{/if}}>k4</option>
            <option value="k6" {{#if (eq system.atrybuty.krzepa.val "k6")}} selected{{/if}}>k6</option>
            <option value="k8" {{#if (eq system.atrybuty.krzepa.val "k8")}} selected{{/if}}>k8</option>
            <option value="k10" {{#if (eq system.atrybuty.krzepa.val "k10")}} selected{{/if}}>k10</option>
            <option value="k12" {{#if (eq system.atrybuty.krzepa.val "k12")}} selected{{/if}}>k12</option>
        </select>
    </div>

    {{!-- zrecznosc --}}
    <div class="attribute-row">
        <label class="attr-name rollable" data-roll="{{system.atrybuty.zrecznosc.val}}" data-label="Zręczność">
            Zręczność:
        </label>

        <select name="system.atrybuty.zrecznosc.max" class="short-input" {{#if locked}} disabled{{/if}}>
            <option value="k4" {{#if (eq system.atrybuty.zrecznosc.max "k4")}} selected{{/if}}>k4</option>
            <option value="k6" {{#if (eq system.atrybuty.zrecznosc.max "k6")}} selected{{/if}}>k6</option>
            <option value="k8" {{#if (eq system.atrybuty.zrecznosc.max "k8")}} selected{{/if}}>k8</option>
            <option value="k10" {{#if (eq system.atrybuty.zrecznosc.max "k10")}} selected{{/if}}>k10</option>
            <option value="k12" {{#if (eq system.atrybuty.zrecznosc.max "k12")}} selected{{/if}}>k12</option>
        </select>

        <select name="system.atrybuty.zrecznosc.val" class="short-input">
            <option value="k4" {{#if (eq system.atrybuty.zrecznosc.val "k4")}} selected{{/if}}>k4</option>
            <option value="k6" {{#if (eq system.atrybuty.zrecznosc.val "k6")}} selected{{/if}}>k6</option>
            <option value="k8" {{#if (eq system.atrybuty.zrecznosc.val "k8")}} selected{{/if}}>k8</option>
            <option value="k10" {{#if (eq system.atrybuty.zrecznosc.val "k10")}} selected{{/if}}>k10</option>
            <option value="k12" {{#if (eq system.atrybuty.zrecznosc.val "k12")}} selected{{/if}}>k12</option>
        </select>
    </div>

    {{!-- spryt --}}
    <div class="attribute-row">
        <label class="attr-name rollable" data-roll="{{system.atrybuty.spryt.val}}" data-label="Spryt">
            Spryt:
        </label>

        <select name="system.atrybuty.spryt.max" class="short-input" {{#if locked}} disabled{{/if}}>
            <option value="k4" {{#if (eq system.atrybuty.spryt.max "k4")}} selected{{/if}}>k4</option>
            <option value="k6" {{#if (eq system.atrybuty.spryt.max "k6")}} selected{{/if}}>k6</option>
            <option value="k8" {{#if (eq system.atrybuty.spryt.max "k8")}} selected{{/if}}>k8</option>
            <option value="k10" {{#if (eq system.atrybuty.spryt.max "k10")}} selected{{/if}}>k10</option>
            <option value="k12" {{#if (eq system.atrybuty.spryt.max "k12")}} selected{{/if}}>k12</option>
        </select>

        <select name="system.atrybuty.spryt.val" class="short-input">
            <option value="k4" {{#if (eq system.atrybuty.spryt.val "k4")}} selected{{/if}}>k4</option>
            <option value="k6" {{#if (eq system.atrybuty.spryt.val "k6")}} selected{{/if}}>k6</option>
            <option value="k8" {{#if (eq system.atrybuty.spryt.val "k8")}} selected{{/if}}>k8</option>
            <option value="k10" {{#if (eq system.atrybuty.spryt.val "k10")}} selected{{/if}}>k10</option>
            <option value="k12" {{#if (eq system.atrybuty.spryt.val "k12")}} selected{{/if}}>k12</option>
        </select>
    </div>

    {{!-- intelekt --}}
    <div class="attribute-row">
        <label class="attr-name rollable" data-roll="{{system.atrybuty.intelekt.val}}" data-label="Intelekt">
            Intelekt:
        </label>

        <select name="system.atrybuty.intelekt.max" class="short-input" {{#if locked}} disabled{{/if}}>
            <option value="k4" {{#if (eq system.atrybuty.intelekt.max "k4")}} selected{{/if}}>k4</option>
            <option value="k6" {{#if (eq system.atrybuty.intelekt.max "k6")}} selected{{/if}}>k6</option>
            <option value="k8" {{#if (eq system.atrybuty.intelekt.max "k8")}} selected{{/if}}>k8</option>
            <option value="k10" {{#if (eq system.atrybuty.intelekt.max "k10")}} selected{{/if}}>k10</option>
            <option value="k12" {{#if (eq system.atrybuty.intelekt.max "k12")}} selected{{/if}}>k12</option>
        </select>

        <select name="system.atrybuty.intelekt.val" class="short-input">
            <option value="k4" {{#if (eq system.atrybuty.intelekt.val "k4")}} selected{{/if}}>k4</option>
            <option value="k6" {{#if (eq system.atrybuty.intelekt.val "k6")}} selected{{/if}}>k6</option>
            <option value="k8" {{#if (eq system.atrybuty.intelekt.val "k8")}} selected{{/if}}>k8</option>
            <option value="k10" {{#if (eq system.atrybuty.intelekt.val "k10")}} selected{{/if}}>k10</option>
            <option value="k12" {{#if (eq system.atrybuty.intelekt.val "k12")}} selected{{/if}}>k12</option>
        </select>
    </div>

    {{!-- osobowosc --}}
    <div class="attribute-row">
        <label class="attr-name rollable" data-roll="{{system.atrybuty.osobowosc.val}}" data-label="Osobowość">
            Osobowość:
        </label>

        <select name="system.atrybuty.osobowosc.max" class="short-input" {{#if locked}} disabled{{/if}}>
            <option value="k4" {{#if (eq system.atrybuty.osobowosc.max "k4")}} selected{{/if}}>k4</option>
            <option value="k6" {{#if (eq system.atrybuty.osobowosc.max "k6")}} selected{{/if}}>k6</option>
            <option value="k8" {{#if (eq system.atrybuty.osobowosc.max "k8")}} selected{{/if}}>k8</option>
            <option value="k10" {{#if (eq system.atrybuty.osobowosc.max "k10")}} selected{{/if}}>k10</option>
            <option value="k12" {{#if (eq system.atrybuty.osobowosc.max "k12")}} selected{{/if}}>k12</option>
        </select>

        <select name="system.atrybuty.osobowosc.val" class="short-input">
            <option value="k4" {{#if (eq system.atrybuty.osobowosc.val "k4")}} selected{{/if}}>k4</option>
            <option value="k6" {{#if (eq system.atrybuty.osobowosc.val "k6")}} selected{{/if}}>k6</option>
            <option value="k8" {{#if (eq system.atrybuty.osobowosc.val "k8")}} selected{{/if}}>k8</option>
            <option value="k10" {{#if (eq system.atrybuty.osobowosc.val "k10")}} selected{{/if}}>k10</option>
            <option value="k12" {{#if (eq system.atrybuty.osobowosc.val "k12")}} selected{{/if}}>k12</option>
        </select>
    </div>

    <div class="row inline-fields pool-row">
        {{!-- przeszukanie --}}
        <label class="rollable" data-label="Przeszukanie" style="cursor: pointer;">PRZESZUKIWANIE:</label>
        <select class="short-input change-search-dice" style="font-weight: bold;">
            <option value="k4" {{#if (eq globalSearchDice "k4")}} selected{{/if}}>k4</option>
            <option value="k6" {{#if (eq globalSearchDice "k6")}} selected{{/if}}>k6</option>
            <option value="k8" {{#if (eq globalSearchDice "k8")}} selected{{/if}}>k8</option>
            <option value="k10" {{#if (eq globalSearchDice "k10")}} selected{{/if}}>k10</option>
            <option value="k12" {{#if (eq globalSearchDice "k12")}} selected{{/if}}>k12</option>
            <option value="k20" {{#if (eq globalSearchDice "k20")}} selected{{/if}}>k20</option>
        </select>
        <a class="reset-search-dice" title="Przywróć Przeszukanie do k12" style="margin-left: 3px; cursor: pointer;">
            <i class="fas fa-undo"></i>
        </a>

        {{!-- pustka --}}
        <label class="rollable" data-label="Pustka">PUSTKA:</label>
        <select name="system.statystyki.pustka" class="short-input">
            <option value="k4" {{#if (eq system.statystyki.pustka "k4")}} selected{{/if}}>k4</option>
            <option value="k6" {{#if (eq system.statystyki.pustka "k6")}} selected{{/if}}>k6</option>
            <option value="k8" {{#if (eq system.statystyki.pustka "k8")}} selected{{/if}}>k8</option>
            <option value="k10" {{#if (eq system.statystyki.pustka "k10")}} selected{{/if}}>k10</option>
            <option value="k12" {{#if (eq system.statystyki.pustka "k12")}} selected{{/if}}>k12</option>
            <option value="k20" {{#if (eq system.statystyki.pustka "k20")}} selected{{/if}}>k20</option>
        </select>

        <label>PD:</label>
        <input type="number" name="system.statystyki.pd" value="{{system.statystyki.pd}}" class="short-input" />
    </div>

    <section class="ceres-section">
        <div class="inventory-title" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
            <h4 style="margin: 5px; color: white;">ZDOLNOŚCI</h4>
            <button type="button" class="ability-create" title="Dodaj zdolność" style="width: auto; padding: 2px 8px; color: white;">
                <i class="fas fa-plus" style="color: white;"></i> Dodaj zdolność
            </button>
        </div>

        <ol class="items-list abilities-list" style="list-style: none; padding: 0; margin: 0;">
            {{#each zdolnosci as |ability|}}
            <li class="item flexrow" data-item-id="{{ability._id}}" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; background: rgba(0,0,0,0.2); padding: 4px; border-radius: 4px;">
                <span class="ability-roll" data-item-id="{{ability._id}}" title="Wyślij na czat" style="cursor: pointer; font-weight: bold; flex-grow: 1;">
                    <i class="fas fa-comment-alt" style="margin-right: 5px;"></i> {{ability.name}} <span style="font-weight: normal; opacity: 0.8;">[Koszt: {{ability.system.cost}}]</span>
                </span>
                <a class="item-delete" title="Usuń zdolność" style="margin-left: 10px; cursor: pointer;"><i class="fas fa-trash"></i></a>
            </li>
            {{/each}}
        </ol>
    </section>

    <section class="ceres-section grid-2col center-text">
        <div>
            <h3>ZDROWIE</h3>
            <label class="checkbox-heart"><input type="checkbox" name="system.statystyki.zdrowie.z1" {{checked system.statystyki.zdrowie.z1}} /><span></span></label>
            <label class="checkbox-heart"><input type="checkbox" name="system.statystyki.zdrowie.z2" {{checked system.statystyki.zdrowie.z2}} /><span></span></label>
            <label class="checkbox-heart"><input type="checkbox" name="system.statystyki.zdrowie.z3" {{checked system.statystyki.zdrowie.z3}} /><span></span></label>
            <label class="checkbox-heart"><input type="checkbox" name="system.statystyki.zdrowie.z4" {{checked system.statystyki.zdrowie.z4}} /><span></span></label>
            <label class="checkbox-heart"><input type="checkbox" name="system.statystyki.zdrowie.z5" {{checked system.statystyki.zdrowie.z5}} /><span></span></label>
            <label class="checkbox-heart"><input type="checkbox" name="system.statystyki.zdrowie.z6" {{checked system.statystyki.zdrowie.z6}} /><span></span></label>
        </div>
        <div>
            <h3>PANCERZ</h3>
            <label class="checkbox-shield"><input type="checkbox" name="system.statystyki.pancerz.p1" {{checked system.statystyki.pancerz.p1}} /><span></span></label>
            <label class="checkbox-shield"><input type="checkbox" name="system.statystyki.pancerz.p2" {{checked system.statystyki.pancerz.p2}} /><span></span></label>
            <label class="checkbox-shield"><input type="checkbox" name="system.statystyki.pancerz.p3" {{checked system.statystyki.pancerz.p3}} /><span></span></label>
            <label class="checkbox-shield"><input type="checkbox" name="system.statystyki.pancerz.p4" {{checked system.statystyki.pancerz.p4}} /><span></span></label>
        </div>
    </section>

    <section class="ceres-section">
        <h3>EKWIPUNEK</h3>
        <div class="inventory-section">
            <div class="inventory-title">
                <button type="button" class="item-create" title="Dodaj przedmiot">
                    <i class="fas fa-plus"></i> Dodaj przedmiot
                </button>
            </div>
            <div class="repair">
                <button type="button" class="btn-repair-items" title="Przywraca trwałe przedmioty do ich maksymalnej kości">
                    Napraw przedmioty (T)
                </button>
            </div>

            <ol class="items-list">
                {{#each ekwipunek as |item|}}
                <li class="item flexrow" data-item-id="{{item._id}}">
                    <span class="item-name roll-item" data-item-id="{{item._id}}" data-label="{{item.name}}" style="cursor: pointer;">
                        {{item.name}}
                    </span>

                    <span class="item-dice">{{item.system.dice}}</span>

                    <label class="checkbox-label" title="Trwałość">
                        <input type="checkbox" class="item-durable-checkbox" {{checked item.system.isDurable}} />
                        <b>T</b>
                    </label>

                    <a class="item-delete"><i class="fas fa-trash"></i></a>
                </li>
                {{/each}}
            </ol>
        </div>
        <div class="row inline-fields margin-top">
            <label>DROBIAZGI:</label>
            <input type="text" name="system.drobiazgi" value="{{system.drobiazgi}}" placeholder="Tu wpisz drobne rzeczy..." />
        </div>
    </section>

    <br />
    <hr class="ceres-divider" />
    <br />

    {{!-- statek --}}
    <section class="ceres-section ship-section">
        <h2>STATEK</h2>
        <div class="row inline-fields">
            <label>NAZWA:</label> <input type="text" name="system.statek.nazwa" value="{{system.statek.nazwa}}" />
            <label>RODZAJ:</label> <input type="text" name="system.statek.rodzaj" value="{{system.statek.rodzaj}}" />
        </div>
        <div class="row inline-fields">
            <label>MIEJSCA:</label> <input type="text" name="system.statek.miejsca" value="{{system.statek.miejsca}}" />
            <label>KADŁUB:</label>
            <input type="number" name="system.statek.kadlub.value" value="{{system.statek.kadlub.value}}" class="short-input" /> /
            <input type="number" name="system.statek.kadlub.max" value="{{system.statek.kadlub.max}}" class="short-input" />
        </div>

        <div class="attribute-title-container" style="display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0;">SYSTEMY</h3>
            <button type="button" class="btn-ship-rest" title="Przywraca wszystkie systemy statku do wartości MAKS.">
                NAPRAW SYSTEMY
            </button>
        </div>

        <div class="attribute-title-container">
            <div class="attribute-row header-row">
                <h2 class="attr-name"></h2>
                <span class="col-head">
                    MAKS.
                    <a class="toggle-lock" title="Zablokuj/Odblokuj edycję MAKS." style="cursor: pointer; margin-left: 3px;">
                        <i class="fas {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
                    </a>
                </span>
                <span class="col-head">OBECNIE</span>
            </div>
        </div>

        <div class="attribute-row">
            <label class="attr-name rollable" data-roll="{{system.statek.systemy.uzbrojenie.val}}" data-label="Uzbrojenie">
                Uzbrojenie:
            </label>
            <select name="system.statek.systemy.uzbrojenie.max" class="short-input" {{#if locked}} disabled{{/if}}>
                <option value="k4" {{#if (eq system.statek.systemy.uzbrojenie.max "k4")}} selected{{/if}}>k4</option>
                <option value="k6" {{#if (eq system.statek.systemy.uzbrojenie.max "k6")}} selected{{/if}}>k6</option>
                <option value="k8" {{#if (eq system.statek.systemy.uzbrojenie.max "k8")}} selected{{/if}}>k8</option>
                <option value="k10" {{#if (eq system.statek.systemy.uzbrojenie.max "k10")}} selected{{/if}}>k10</option>
                <option value="k12" {{#if (eq system.statek.systemy.uzbrojenie.max "k12")}} selected{{/if}}>k12</option>
            </select>

            <select name="system.statek.systemy.uzbrojenie.val" class="short-input">
                <option value="k4" {{#if (eq system.statek.systemy.uzbrojenie.val "k4")}} selected{{/if}}>k4</option>
                <option value="k6" {{#if (eq system.statek.systemy.uzbrojenie.val "k6")}} selected{{/if}}>k6</option>
                <option value="k8" {{#if (eq system.statek.systemy.uzbrojenie.val "k8")}} selected{{/if}}>k8</option>
                <option value="k10" {{#if (eq system.statek.systemy.uzbrojenie.val "k10")}} selected{{/if}}>k10</option>
                <option value="k12" {{#if (eq system.statek.systemy.uzbrojenie.val "k12")}} selected{{/if}}>k12</option>
            </select>
        </div>

        <div class="attribute-row">
            <label class="attr-name rollable" data-roll="{{system.statek.systemy.naped.val}}" data-label="Napęd">
                Napęd:
            </label>
            <select name="system.statek.systemy.naped.max" class="short-input" {{#if locked}} disabled{{/if}}>
                <option value="k4" {{#if (eq system.statek.systemy.naped.max "k4")}} selected{{/if}}>k4</option>
                <option value="k6" {{#if (eq system.statek.systemy.naped.max "k6")}} selected{{/if}}>k6</option>
                <option value="k8" {{#if (eq system.statek.systemy.naped.max "k8")}} selected{{/if}}>k8</option>
                <option value="k10" {{#if (eq system.statek.systemy.naped.max "k10")}} selected{{/if}}>k10</option>
                <option value="k12" {{#if (eq system.statek.systemy.naped.max "k12")}} selected{{/if}}>k12</option>
                <option value="k20" {{#if (eq system.statek.systemy.naped.max "k20")}} selected{{/if}}>k20</option>
            </select>

            <select name="system.statek.systemy.naped.val" class="short-input">
                <option value="k4" {{#if (eq system.statek.systemy.naped.val "k4")}} selected{{/if}}>k4</option>
                <option value="k6" {{#if (eq system.statek.systemy.naped.val "k6")}} selected{{/if}}>k6</option>
                <option value="k8" {{#if (eq system.statek.systemy.naped.val "k8")}} selected{{/if}}>k8</option>
                <option value="k10" {{#if (eq system.statek.systemy.naped.val "k10")}} selected{{/if}}>k10</option>
                <option value="k12" {{#if (eq system.statek.systemy.naped.val "k12")}} selected{{/if}}>k12</option>
                <option value="k20" {{#if (eq system.statek.systemy.naped.val "k20")}} selected{{/if}}>k20</option>
            </select>
        </div>

        <div class="attribute-row">
            <label class="attr-name rollable" data-roll="{{system.statek.systemy.skanery.val}}" data-label="Skanery">
                Skanery:
            </label>
            <select name="system.statek.systemy.skanery.max" class="short-input" {{#if locked}} disabled{{/if}}>
                <option value="k4" {{#if (eq system.statek.systemy.skanery.max "k4")}} selected{{/if}}>k4</option>
