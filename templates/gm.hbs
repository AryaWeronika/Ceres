<form class="{{cssClass}} ceres-sheet ceres-gm-sheet" autocomplete="off">
    <header class="ceres-header">
        <h1 class="ceres-title">CERES — EKRAN MG</h1>
        <div class="ceres-row">
            <label><b>KAMPANIA / SCENARIUSZ:</b></label>
            <input type="text" name="system.campaign" value="{{system.campaign}}" placeholder="Tytuł sesji..." />
        </div>
    </header>

    <!-- zakładki nawigacja -->
    <nav class="sheet-tabs tabs" data-group="primary" style="display: flex; gap: 5px; margin: 10px 0; border-bottom: 2px solid #000;">
        <a class="item tab-btn" data-tab="opponents"><b>PRZECIWNICY</b></a>
        <a class="item tab-btn" data-tab="challenges"><b>WYZWANIA</b></a>
    </nav>

    <section class="sheet-body">

        <div class="tab opponents" data-group="primary" data-tab="opponents">
            <div class="ceres-bar-header" style="display: flex; justify-content: space-between; align-items: center;">
                <span>LISTA PRZECIWNIKÓW & NPC</span>
                <button type="button" class="add-npc-btn">+ Dodaj Przeciwnika</button>
            </div>

            <div class="npc-list">
                {{#each system.opponents as |npc index|}}
                <div class="npc-card" data-index="{{index}}" style="border: 1px solid #000; padding: 10px; margin-top: 10px; background: #fafafa;">
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ccc; padding-bottom: 5px;">
                        <input type="text" name="system.opponents.{{index}}.name" value="{{npc.name}}" style="font-weight: bold; font-size: 1.1em; width: 70%;" />
                        <button type="button" class="remove-npc-btn" data-index="{{index}}" style="width: auto; background: none; border: none; cursor: pointer; color: #ff4d4d;"><i class="fas fa-trash"></i></button>
                    </div>

                    <div style="margin-top: 5px;">
                        <label><b>Opis:</b></label>
                        <input type="text" name="system.opponents.{{index}}.description" value="{{npc.description}}" />
                    </div>

                    <!-- statystyki moby -->
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; margin-top: 8px; background: #fff; padding: 5px; border: 1px dashed #999;">
                        <div><label>Zdrowie:</label> <input type="text" name="system.opponents.{{index}}.hp" value="{{npc.hp}}" placeholder="4/4" /></div>
                        <div><label>Obrażenia (Obr.):</label> <input type="text" name="system.opponents.{{index}}.damage" value="{{npc.damage}}" placeholder="6" /></div>
                        <div><label>Pancerz:</label> <input type="text" name="system.opponents.{{index}}.armor" value="{{npc.armor}}" placeholder="0" /></div>
                    </div>

                    <div style="margin-top: 5px;">
                        <label><b>Wyposażenie:</b></label>
                        <input type="text" name="system.opponents.{{index}}.equipment" value="{{npc.equipment}}" />
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        <div class="tab challenges" data-group="primary" data-tab="challenges">
            <div class="ceres-bar-header" style="display: flex; justify-content: space-between; align-items: center;">
                <span>WYZWANIA</span>
                <button type="button" class="add-challenge-btn">+ Dodaj Wyzwanie</button>
            </div>

            <div class="challenge-list">
                {{#each system.challenges as |ch index|}}
                <div class="challenge-card" data-index="{{index}}" style="border: 1px solid #000; padding: 10px; margin-top: 10px; background: #fafafa;">
                    <div style="display: flex; gap: 8px; align-items: center; border-bottom: 1px solid #ccc; padding-bottom: 5px;">
                        <input type="text" name="system.challenges.{{index}}.title" value="{{ch.title}}" placeholder="Nazwa wyzwania" style="font-weight: bold; flex: 2;" />
                        <button type="button" class="remove-challenge-btn" data-index="{{index}}" style="width: auto; background: none; border: none; cursor: pointer; color: #ff4d4d;"><i class="fas fa-trash"></i></button>
                    </div>

                    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 8px; margin-top: 8px; background: #fff; padding: 6px; border: 1px dashed #999;">
                        <div>
                            <label><b>Typ wyzwania:</b></label>
                            <select name="system.challenges.{{index}}.difficulty">
                                <option value="Niepewne (3)" {{#if (eq ch.difficulty "Niepewne (3)")}} selected{{/if}}>Niepewne (Pula Sukcesów 3)</option>
                                <option value="Ryzykowne (5)" {{#if (eq ch.difficulty "Ryzykowne (5)")}} selected{{/if}}>Ryzykowne (Pula Sukcesów 5)</option>
                                <option value="Niebezpieczne (8)" {{#if (eq ch.difficulty "Niebezpieczne (8)")}} selected{{/if}}>Niebezpieczne (Pula Sukcesów 8)</option>
                                <option value="Beznadziejne (13)" {{#if (eq ch.difficulty "Beznadziejne (13)")}} selected{{/if}}>Beznadziejne (Pula Sukcesów 13)</option>
                            </select>
                        </div>
                        <div>
                            <label><b>Pula sukcesów:</b></label>
                            <input type="text" name="system.challenges.{{index}}.successPool" value="{{ch.successPool}}" style="text-align: center;" />
                        </div>
                    </div>

                    <div style="margin-top: 6px;">
                        <input type="text" name="system.challenges.{{index}}.details" value="{{ch.details}}" placeholder="Konsekwencje porażki" />
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

    </section>
</form>